{
  "manifest_version": 3,
  "name": "A11yscan",
  "version": "0.1.0",
  "description": "Scanner d'accessibilité RGAA (axe-core) pour la page active",
  "browser_specific_settings": {
    "gecko": {
      "id": "a11yscan@example.dev",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "A11yscan",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "activeTab", "storage"]
}
